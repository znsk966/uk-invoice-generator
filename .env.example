# Copy this file to backend/.env (or export the variable) and adjust as needed.
# Replace CHANGE_ME with your local database password. If the password contains
# URL-reserved characters (@ : / ? # [ ] etc.), URL-encode them in the value below.
DATABASE_URL=postgresql+psycopg://uk_invoice_user:CHANGE_ME@localhost:5432/uk_invoice_db

# Session cookie Secure flag. Leave false for local HTTP dev; set true in any
# deployment served over HTTPS so the session cookie is never sent in the clear.
COOKIE_SECURE=false
